# Copy to .env (or export in your shell / service manager). Everything can also be set in the studio.
# Nothing here is required: AI uses your Claude Code or Codex (ChatGPT) login or a local LM Studio model,
# the voice is local, and weather/traffic are keyless.
PORT=8080
# Protect the studio (the stream, /listen and /api/nowplaying stay public)
ADMIN_PASSWORD=
# Claude Code login for servers: run `claude setup-token` once and paste the token here
CLAUDE_CODE_OAUTH_TOKEN=
# Local LM Studio server (OpenAI-compatible)
LMSTUDIO_URL=http://localhost:1234/v1
# Optional API keys (Claude API, OpenAI API)
ANTHROPIC_API_KEY=
# OpenAI key: the OpenAI API provider and OpenAI voices. ElevenLabs: premium voices.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Start broadcasting as soon as the server boots
AUTOSTART=0
# Where the database, caches, uploads and the local voice live
VALHALLA_DATA_DIR=./data
# FFMPEG_PATH=/usr/bin/ffmpeg
