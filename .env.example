# Copy to .env (or export in your shell / service manager). Everything can also be set in the studio.
# Nothing here is required: AI uses your Claude Code login, the voice is local, and weather/traffic are keyless.
PORT=8080
# Protect the studio (the stream, /listen and /api/nowplaying stay public)
ADMIN_PASSWORD=
# Claude Code login for servers: run `claude setup-token` once and paste the token here
CLAUDE_CODE_OAUTH_TOKEN=
# Optional fallback for Claude
ANTHROPIC_API_KEY=
# Optional premium voices (the free local voice works without them)
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Start broadcasting as soon as the server boots
AUTOSTART=0
# Where the database, caches, uploads and the local voice live
VALHALLA_DATA_DIR=./data
# FFMPEG_PATH=/usr/bin/ffmpeg
