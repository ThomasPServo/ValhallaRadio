# Copy to .env (or export in your shell / service manager). All keys can also be set in the Studio UI → Settings.
PORT=8080
# Protect the studio (the stream, /listen and /api/nowplaying stay public)
ADMIN_PASSWORD=
# Claude: music director, DJ script writer, AI programmer
ANTHROPIC_API_KEY=
# Voice (pick one). ElevenLabs is the most human-sounding.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Live traffic incidents (optional, https://developer.tomtom.com)
TOMTOM_API_KEY=
# Start broadcasting as soon as the server boots
AUTOSTART=0
# Where the database, music cache and uploads live
VALHALLA_DATA_DIR=./data
# FFMPEG_PATH=/usr/bin/ffmpeg
